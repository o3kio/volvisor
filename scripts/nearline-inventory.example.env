# Nearline multi-host campaign inventory — EXAMPLE / PLACEHOLDERS ONLY.
#
# Copy this file OUTSIDE the repository, e.g.:
#   install -m 0600 scripts/nearline-inventory.example.env /etc/volvisor/nearline-inventory.env
# Then replace every REPLACE_* value with the real campaign inventory.
#
# NEVER commit a completed copy of this file: it contains real hostnames,
# addresses, paths and (potentially) operator identity. The repository must
# only ever contain this placeholder template.
#
# Format: one KEY=VALUE per line. Values are parsed, NOT sourced. Comments
# start with '#'. No whitespace around '=' is required; leading/trailing
# whitespace is trimmed. Do not use shell expansions here.
#
# Topology required by issue #37:
#   host A = data replica 1 + VMM source
#   host B = data replica 2 + VMM destination
#   host C = independent campaign/oracle host (a third physical failure
#            domain; it is NOT a data replica and does not count as one)
#   witness = fourth failure domain (never colocated with A, B or C)
#
# If a real deployment cannot provide four failure domains, do not silently
# shrink this file: record the equivalent in the run's REPORT.md and in the
# campaign issue before running anything.

CAMPAIGN_ID=REPLACE_WITH_CAMPAIGN_ID

# SSH targets. Use BatchMode-compatible keys; the preflight never prompts.
HOST_A_SSH=root@host-a.example.invalid
HOST_B_SSH=root@host-b.example.invalid
HOST_C_SSH=root@host-c.example.invalid
WITNESS_SSH=root@witness.example.invalid
# Optional private key path (outside the repository).
SSH_IDENTITY_FILE=/etc/volvisor/campaign-id_ed25519
SSH_CONNECT_TIMEOUT=5

# Failure-domain labels. All four must be distinct; the preflight refuses
# duplicates. These are operator assertions about chassis/power/network
# independence, not values inferred from hostnames.
HOST_A_FAILURE_DOMAIN=dc-a-rack-1
HOST_B_FAILURE_DOMAIN=dc-b-rack-1
HOST_C_FAILURE_DOMAIN=dc-c-rack-1
WITNESS_FAILURE_DOMAIN=dc-w-rack-1

# DRBD node names (must match each host's `uname -n`).
HOST_A_DRBD_NODE=host-a
HOST_B_DRBD_NODE=host-b
HOST_C_DRBD_NODE=host-c
WITNESS_DRBD_NODE=witness

# Replication addresses/port for the A<->B DRBD link and A/B -> witness
# reachability probes. Use IPv4 dotted quads; the template deliberately uses
# TEST-NET-1 / documentation ranges.
HOST_A_REPL_ADDRESS=192.0.2.11
HOST_B_REPL_ADDRESS=192.0.2.12
DRBD_PORT=7100

# Witness HTTP surface and its state directory.
WITNESS_URL=http://192.0.2.40:9101
WITNESS_ADDRESS=192.0.2.40
WITNESS_PORT=9101
WITNESS_STATE_DIR=/var/lib/volvisor-witness/state

# Daemon configurations and binaries (absolute paths on the target hosts).
VOLVISORD_BIN=/usr/bin/volvisord
WITNESSD_BIN=/usr/bin/volvisor-witnessd
HOST_A_CONFIG=/etc/volvisor/volvisor.toml
HOST_B_CONFIG=/etc/volvisor/volvisor.toml
WITNESS_CONFIG=/etc/volvisor/witnessd.toml

# Paths that must exist and have free space on the named hosts.
JOURNAL_DIR=/var/lib/volvisor/journal
SNAPSHOT_DIR=/var/lib/volvisor/snapshots
# Host C stores the campaign's raw evidence outside the repository.
HOST_C_EVIDENCE_DIR=/var/lib/volvisor-campaign

# Nearline backing volume group (must already exist; foreign LVs are never
# touched by the daemon).
DRBD_VG=volvisor-nearline

# Preflight thresholds. Clock skew is measured once per host against the
# operator workstation; fix NTP/chrony rather than raising this casually.
MIN_FREE_GIB=50
MAX_CLOCK_SKEW_SECS=5
