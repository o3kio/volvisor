# Three-physical-host Rook-cell POC inventory — EXAMPLE / PLACEHOLDERS ONLY.
#
# Copy this file OUTSIDE the repository, e.g.:
#   install -m 0600 scripts/rook-cell-inventory.example.env /etc/volvisor/rook-cell-inventory.env
# Then replace every REPLACE_* / example value with the real campaign inventory.
#
# NEVER commit a completed copy of this file: it contains real hostnames,
# addresses, Kubernetes context names and paths. The repository must only ever
# contain this placeholder template.
#
# Format: one KEY=VALUE per line. Values are parsed, NOT sourced. Comments
# start with '#'. No whitespace around '=' is required; leading/trailing
# whitespace is trimmed. Do not use shell expansions here.
#
# Topology required by issue #38:
#   three physical hosts in distinct failure domains, each running exactly one
#   dedicated Cloud Hypervisor cell VM registered as a Kubernetes worker Node
#   (volvisor-cell-a/b/c). The Kubernetes API/etcd and the Rook operator live
#   on an independent management plane, never inside these cells.

CAMPAIGN_ID=REPLACE_WITH_CAMPAIGN_ID

# SSH targets for the three PHYSICAL hosts. BatchMode-compatible keys only.
HOST_A_SSH=root@host-a.example.invalid
HOST_B_SSH=root@host-b.example.invalid
HOST_C_SSH=root@host-c.example.invalid
# Optional private key path (outside the repository).
SSH_IDENTITY_FILE=/etc/volvisor/campaign-id_ed25519
SSH_CONNECT_TIMEOUT=5

# Physical failure domains. Must be three distinct chassis/power/network
# domains; three cells on one physical host are NOT three failure domains.
HOST_A_FAILURE_DOMAIN=dc-a-rack-1
HOST_B_FAILURE_DOMAIN=dc-b-rack-1
HOST_C_FAILURE_DOMAIN=dc-c-rack-1

# Kubernetes worker Node names, one per physical host.
CELL_NODE_A=volvisor-cell-a
CELL_NODE_B=volvisor-cell-b
CELL_NODE_C=volvisor-cell-c

# Trusted labels/taint configured by management automation (never tenant input).
CELL_ROLE_LABEL=volvisor.io/node-role
CELL_ROLE_VALUE=storage-cell
CELL_FD_LABEL=topology.kubernetes.io/zone
CELL_TAINT_KEY=volvisor.io/storage-only
CELL_TAINT_VALUE=rook
CELL_TAINT_EFFECT=NoSchedule

# Namespaces allowed to run Pods on a cell: essential node system services and
# Rook/Ceph. Any other namespace is a preflight failure (no tenant Pods).
ALLOWED_CELL_NAMESPACES=kube-system,rook-ceph

# Kubernetes access. KUBECONFIG must point outside the repository; the
# preflight and collector never print token material.
KUBECONFIG=/etc/volvisor/kubeconfig-rook-poc
KUBE_CONTEXT=rook-poc-mgmt
ROOK_NAMESPACE=rook-ceph
ROOK_OPERATOR_NAMESPACE=rook-ceph
CEPHCLUSTER_NAME=rook-ceph
CEPHBLOCKPOOL_NAME=volvisor-poc-rbd

# One exclusively VFIO-passed NVMe controller per physical host. Use the
# stable PCI address from discovery; never a /dev/nvmeXnY guess.
HOST_A_VFIO_BDF=0000:01:00.0
HOST_B_VFIO_BDF=0000:01:00.0
HOST_C_VFIO_BDF=0000:01:00.0
# Optional, from the discovery record. If the controller is already
# vfio-bound the kernel nvme driver may no longer expose the serial; the
# preflight then records the limitation rather than inventing a value.
#HOST_A_NVME_SERIAL=REPLACE_WITH_DISCOVERY_SERIAL_A

# Raw evidence root on the independent campaign controller (host C). MUST be
# outside the repository and large enough for 24h/POC logs and command output.
EVIDENCE_ROOT=/var/lib/volvisor-campaign
MIN_FREE_GIB=50

# Repo-relative or absolute path of the read-only collector (default source
# tree copy; the installed package may place it elsewhere).
VOLVISOR_COLLECT_EVIDENCE=docs/poc/rook-cells/collect-evidence.sh
